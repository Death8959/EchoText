# Which model backend to use: "template" (works out of the box, no downloads)
# or "phi_lora" (requires a trained adapter — see app/training/train_lora.py)
MODEL_BACKEND=template
ADAPTER_PATH=./adapter
BASE_MODEL=microsoft/Phi-3.5-mini-instruct

# How many similar past exchanges to retrieve per incoming message
RAG_TOP_K=3

# Only needed if you run the matching integration
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
GMAIL_CREDENTIALS_PATH=./credentials.json

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
